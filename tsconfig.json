{
  "compilerOptions": {
    "typeRoots": [
      "node_modules/@types"
    ],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "importsNotUsedAsValues": "remove"
  },
  "include": [
    "src/**/*.ts"
  ]
}